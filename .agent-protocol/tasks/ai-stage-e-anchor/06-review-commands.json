{
  "version": 1,
  "network_policy": "deny-declared-not-enforced",
  "commands": [
    {
      "name": "whitespace-and-conflict-check",
      "file": "git",
      "args": [
        "diff",
        "--check"
      ],
      "working_directory": ".",
      "timeout_sec": 120
    },
    {
      "name": "ai-anchor-unit-tests",
      "file": "cmd.exe",
      "args": [
        "/c",
        ".\\gradlew.bat",
        ":app:testAppDebugUnitTest",
        "--tests",
        "io.legado.app.help.ai.AiOutputValidatorTest",
        "--tests",
        "io.legado.app.help.ai.AiNoChangeTest",
        "--tests",
        "io.legado.app.help.ai.OpenAiCompatibleProviderTest",
        "--console=plain"
      ],
      "working_directory": ".",
      "timeout_sec": 1800
    }
  ]
}
